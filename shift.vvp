#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/aarch64-linux-gnu/ivl/v2009.vpi";
S_0xc5f04ef9c040 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0xc5f04ef9c1d0 .scope module, "tb_shift_left_right" "tb_shift_left_right" 3 2;
 .timescale 0 0;
v0xc5f04efae940_0 .var "control", 0 0;
v0xc5f04efaea10_0 .var "frac_in", 22 0;
v0xc5f04efaeae0_0 .net "frac_out", 22 0, v0xc5f04efae800_0;  1 drivers
S_0xc5f04ef62650 .scope module, "dut" "shift_left_right" 3 8, 4 2 0, S_0xc5f04ef9c1d0;
 .timescale 0 0;
    .port_info 0 /INPUT 23 "frac_in";
    .port_info 1 /INPUT 1 "control";
    .port_info 2 /OUTPUT 23 "frac_out";
v0xc5f04ef62850_0 .net "control", 0 0, v0xc5f04efae940_0;  1 drivers
v0xc5f04efae720_0 .net "frac_in", 22 0, v0xc5f04efaea10_0;  1 drivers
v0xc5f04efae800_0 .var "frac_out", 22 0;
E_0xc5f04ef9b540 .event anyedge, v0xc5f04ef62850_0, v0xc5f04efae720_0;
    .scope S_0xc5f04ef62650;
T_0 ;
Ewait_0 .event/or E_0xc5f04ef9b540, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0xc5f04ef62850_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v0xc5f04efae720_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %store/vec4 v0xc5f04efae800_0, 0, 23;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0xc5f04efae720_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %store/vec4 v0xc5f04efae800_0, 0, 23;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0xc5f04ef9c1d0;
T_1 ;
    %vpi_call/w 3 15 "$dumpfile", "shift_left_right.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0xc5f04ef9c1d0 {0 0 0};
    %pushi/vec4 4, 0, 23;
    %store/vec4 v0xc5f04efaea10_0, 0, 23;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xc5f04efae940_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 4, 0, 23;
    %store/vec4 v0xc5f04efaea10_0, 0, 23;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xc5f04efae940_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 32, 0, 23;
    %store/vec4 v0xc5f04efaea10_0, 0, 23;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0xc5f04efae940_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 32, 0, 23;
    %store/vec4 v0xc5f04efaea10_0, 0, 23;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0xc5f04efae940_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 38 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
